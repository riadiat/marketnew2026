{{ header }}
<div id="common-success" class="uk-container uk-container-center uk-margin-large-top">

  <div class="uk-panel uk-panel-box uk-panel-box-secondary">
    <ul class="uk-breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>
    <h1 class="uk-panel-title">{{ heading_title }}</h1>
    <div class="content-text uk-text-center">{{ text_message }}</div>
    <div class="buttons uk-text-center uk-margin-top">
        <a href="{{ link }}" class="btn btn-primary">{% if isLogged %}{{ button_go_order }}{% else %}{{ button_go_home }}{% endif %}</a>
    </div>
  </div>
</div>
{{ footer }}
