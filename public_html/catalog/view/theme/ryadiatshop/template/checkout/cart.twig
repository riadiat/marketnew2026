{{ header }}
<div id="checkout-cart" class="uk-container uk-container-center uk-margin-large-top">
  <div class="uk-panel uk-panel-box uk-panel-box-secondary">
      <ul class="uk-breadcrumb">
          {% for breadcrumb in breadcrumbs %}
              <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% endfor %}
      </ul>
    <h1 class="uk-panel-title">{{ heading_title }}
        {% if weight %}
          &nbsp;({{ weight }})
        {% endif %}</h1>

      {% if attention %}
        <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ attention }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}


    <form id="cart-form" action="{{ action }}" method="post" enctype="multipart/form-data">
      <div class="custom-table-responsive">
        <table class="table table-bordered uk-table-middle uk-text-center cart-table">
          <thead>
          <tr>
            <td>{{ column_image }}</td>
            <td>{{ column_name }}</td>
            <td style="width: 100px">{{ column_quantity }}</td>
            <td>{{ column_price }}</td>
            <td>{{ column_total }}</td>
            <td>{{ column_remove }}</td>
          </tr>
          </thead>
          <tbody>

          {% for product in products %}
            <tr>
              <td data-title="{{ column_image }}">{% if product.thumb %} <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a> {% endif %}</td>
              <td data-title="{{ column_name }}"><a href="{{ product.href }}">{{ product.name }}</a> {% if not product.stock %} <span class="text-danger">***</span> {% endif %}
                  {% if product.option %}
                      {% for option in product.option %} <br />
                        <small>{{ option.name }}: {{ option.value }}</small> {% endfor %}
                  {% endif %}
                  {% if product.reward %} <br />
                    <small>{{ product.reward }}</small> {% endif %}
                  {% if product.recurring %} <br />
                    <span class="label label-info">{{ text_recurring_item }}</span> <small>{{ product.recurring }}</small> {% endif %}</td>
              <td data-title="{{ column_quantity }}" class="text-left">
                <input type="number" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" size="1" class="form-control uk-text-center" placeholder="" />
              </td>
              <td data-title="{{ column_price }}">{{ product.price }}</td>
              <td data-title="{{ column_total }}">{{ product.total }}</td>
              <td data-title="{{ column_remove }}">
                <button type="button" class="uk-button uk-button-link btn-remove-cart" onclick="cart.remove('{{ product.cart_id }}');"><i class="fa fa-times"></i></button>
              </td>
            </tr>
          {% endfor %}
          {% for voucher in vouchers %}
            <tr>
              <td></td>
              <td class="text-left">{{ voucher.description }}</td>
              <td class="text-left"></td>
              <td class="text-left"><div class="input-group btn-block" style="max-width: 200px;">
                  <input type="text" name="" value="1" size="1" disabled="disabled" class="form-control" />
                  <span class="input-group-btn">
                  <button type="button" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger" onclick="voucher.remove('{{ voucher.key }}');"><i class="fa fa-times-circle"></i></button>
                  </span></div></td>
              <td class="text-right">{{ voucher.amount }}</td>
              <td class="text-right">{{ voucher.amount }}</td>
            </tr>
          {% endfor %}
          </tbody>
            <tfoot>
            <tr>
                {% for total in totals %}
                    {% if total.code =='total' %}
                        <td class="uk-text-right" colspan="5">{{ total.title }}</td>
                        <td>{{ total.text }}</td>
                    {% endif %}
                {% endfor %}
            </tr>
            </tfoot>
        </table>
      </div>
        <div class="uk-visible-small cart-total uk-margin-bottom">
            {% for total in totals %}
                {% if total.code =='total' %}
                    <div class="uk-grid uk-grid-small">
                        <div class="uk-width-1-2">{{ total.title }}</div>
                        <div class="uk-width-1-2 uk-text-right">{{ total.text }}</div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </form>
      <div class="uk-grid" data-uk-grid-margin data-uk-grid-match>
          <div class="uk-width-medium-5-10">
              {% if modules %}
                  <div class="panel-group" id="accordion">
                      {% for module in modules %}
                          {{ module }}
                      {% endfor %}
                  </div>
              {% endif %}
          </div>
          <div class="uk-width-medium-2-10 uk-hidden-small"></div>
          <div class="uk-width-medium-3-10 uk-text-right">
              <div class="uk-grid uk-grid-small" data-uk-grid-margin data-uk-grid-match>
                  <div class="uk-width-1-2">
                      <button type="submit" form="cart-form" class="btn btn-primary btn-c btn-block">{{ button_update }}</button>
                  </div>
                  <div class="uk-width-1-2">
                      <a href="{{ continue }}" class="btn uk-button-primary-2 btn-c btn-block">{{ button_shopping }}</a>
                  </div>
              </div>

          </div>
          <div class="uk-width-medium-5-10">
              <a href="{{ checkout }}" class="btn btn-block btn-primary">{{ button_checkout }}</a>
          </div>
      </div>

  </div>


</div>
{{ footer }}
