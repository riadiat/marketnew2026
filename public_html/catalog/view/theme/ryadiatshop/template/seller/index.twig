{{ header }}

<div id="seller-index">
    <div class="uk-container uk-container-center">
        <div class="block-banner" style="background-image: url('{{ banner }}')">
            <div class="block-avatar">
                <a href="{{ current_url }}"><img src="{{ thumb }}" alt=""></a>
                <h3>{{ firstname }} {{ lastname }}</h3>
            </div>
        </div>

        <div class="uk-panel uk-panel-box uk-panel-box-secondary uk-margin-bottom-remove">
            <ul class="uk-breadcrumb uk-breadcrumb-no">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>




        <div class="uk-grid uk-grid-collapse" data-uk-grid-match>
            {#<div class="uk-width-medium-2-10 uk-push-8-10">
                <ul class="list-seller-tab">
                    #}{#<li class="active"><a href="#products" aria-controls="products" role="tab" data-toggle="tab">{{ text_product_designer }}</a></li>#}{#
                    {% if description %}
                    <li class="active"><a href="#desc" aria-controls="desc" role="tab" data-toggle="tab">{{ text_about_designer }}</a></li>
                    {% endif %}
                </ul>
            </div>#}
            <div class="uk-width-medium-1-1">
                <div class="content-text uk-margin-large-bottom">{{ description }}</div>

                {% if categories %}
                    <ul class="list-seller-category">
                        {% for category in categories %}
                            <li {% if category.active %}class="active"{% endif %}><a href="{{ category.link }}">{{ category.name }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if products %}
                    <div class="uk-grid uk-grid-small margin-product uk-grid-width-1-2 uk-grid-width-medium-1-4" data-uk-grid-margin="" data-uk-grid-match="{target:'.block-product'">
                        {% for product in products %}
                            <div>
                                {% include 'ryadiatshop/template/product/_block_product.twig' with product %}
                            </div>
                        {% endfor %}

                        {% if pagination %}
                            <div class="uk-width-1-1">
                                {{ pagination }}
                            </div>
                        {% endif %}
                    </div>

                {% else %}
                    <div class="empty">
                        {{ text_empty_products }}
                    </div>
                {% endif %}
                {#
                <div class="tab-content">
                    {% if description %}
                    <div role="tabpanel" class="tab-pane fade" id="desc">
                        <div class="content-text">{{ description }}</div>
                    </div>
                    {% endif %}
                    <div data-uk-observe  role="tabpanel" class="tab-pane fade in active" id="products">
                        {% if categories %}
                        <ul class="list-seller-category">
                            {% for category in categories %}
                            <li {% if category.active %}class="active"{% endif %}><a href="{{ category.link }}">{{ category.name }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}

                        {% if products %}
                            <div class="uk-grid uk-grid-small margin-product uk-grid-width-1-2 uk-grid-width-medium-1-3" data-uk-grid-margin="" data-uk-grid-match="{target:'.block-product'">
                                {% for product in products %}
                                    <div>
                                        {% include 'ryadiatshop/template/product/_block_product.twig' with product %}
                                    </div>
                                {% endfor %}

                                {% if pagination %}
                                    <div class="uk-width-1-1">
                                        {{ pagination }}
                                    </div>
                                {% endif %}
                            </div>

                        {% else %}
                            <div class="empty">
                                {{ text_empty_products }}
                            </div>
                        {% endif %}
                    </div>
                </div>#}
            </div>
        </div>
    </div>
</div>
<script>
    $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {

    });
</script>
{{ footer }}
