<div class="block-title block-title-cu  uk-clearfix">
    <div class="uk-float-left">
        <h3>{{ title }}</h3>
    </div>
    <div class="uk-float-right">
        <ul class="list-slider-button">
            <li><button class="slider-f-button-next{{ module }}" type="button"><i class="fa fa-angle-right"></i></button></li>
            <li><button class="slider-f-button-prev{{ module }}" type="button"><i class="fa fa-angle-left"></i></button></li>
        </ul>
    </div>
</div>
<div id="slider-f-{{ module }}" class="swiper-container">
    <div class="swiper-wrapper">
        {% for product in products %}
            <div class="swiper-slide">
                <div class="uk-margin-bottom">
                    {% include 'ryadiatshop/template/product/_block_product.twig' with product %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
<script type="text/javascript">
    var mySwiper{{ module }} = new Swiper('#slider-f-{{ module }}', {
        slidesPerView: 4,
        simulateTouch:true,
        loop: false,
        autoplay: {
            delay: 2500,
        },
        navigation: {
            nextEl: '.slider-f-button-next{{ module }}',
            prevEl: '.slider-f-button-prev{{ module }}'
        },
        spaceBetween: 10,
        breakpoints: {
            1075: {
                slidesPerView: 4,
                loop: true
            },
            768: {
                slidesPerView: 3,
                loop: true
            },
            640: {
                slidesPerView: 2,
                loop: true
            },
            320: {
                slidesPerView: 2,
                loop: true
            }
        }
    });
</script>
