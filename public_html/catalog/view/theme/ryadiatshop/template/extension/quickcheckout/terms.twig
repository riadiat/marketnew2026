<div id="payment" class="text-left" style="display:none;"></div>
<div class="terms clearfix hidden">
  <div class="uk-float-left">
    <label>{% if text_agree %}

        {{ text_agree }}
      {% endif %}</label>
  </div>
    <input checked="checked" type="checkbox" name="agree" value="1" />

</div>

<div class="uk-text-center">
  <button type="button" id="button-payment-method" class="btn btn-primary btn-700" data-loading-text="{{ text_loading }}">{{ button_checkout }}</button>
</div>
