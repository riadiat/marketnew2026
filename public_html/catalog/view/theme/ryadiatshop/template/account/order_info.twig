{{ header }}
<div id="account-order" class="uk-container uk-container-center uk-margin-large-top">

  <div class="uk-panel uk-panel-box uk-panel-box-secondary">
      <ul class="uk-breadcrumb">
          {% for breadcrumb in breadcrumbs %}
              <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% endfor %}
      </ul>
    <h1 class="uk-panel-title">{{ heading_title }}</h1>
      {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}



    <div class="uk-grid" data-uk-grid data-uk-grid-match>
      <div class="uk-width-medium-2-3">

        <ul class="list-order-status">
          {% if order_status_id != 4 and order_status_id != 5 %}
            <li class="active">
              <span class="icon"><i class="uk-icon-check"></i></span>
              <span>{{ text_order_first }}</span>
            </li>
            {% for status in orders_status %}
            <li {% if status.active %}class="active" {% endif %}>
              <span class="icon"><i class="uk-icon-check"></i></span>
              <span>{{ status.name }}</span>
            </li>
            {% endfor %}
          {% else %}
            <li class="fail">
              <span class="icon"><i class="uk-icon-times-circle"></i></span>
              <span>{% if order_status_id == 4 %}{{ text_canceled }}{% else %}{{ text_fail }}{% endif %}</span>
            </li>
          {% endif %}
        </ul>


          {% if histories %}
            <div class="block-account-p">
              <h3>{{ text_history }}</h3>
              <ul class="list-history">
                  {% for history in histories %}
                      {% if history.comment %}
                        <li>
                          <div class="head uk-clearfix">
                            <div class="uk-float-right">
                              <span>{{ history.date_added }}</span>
                            </div>
                            <div class="uk-float-left">
                              <span>{{ history.status }}</span>
                            </div>
                          </div>
                          <div class="content-text">
                              {{ history.comment }}
                          </div>
                        </li>
                      {% endif %}

                  {% endfor %}
              </ul>
            </div>
          {% endif %}


        <div class="block-account-p">
          <h3>{{ text_products }}</h3>
          <div class="custom-table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
              <tr>
                <td>{{ column_image }}</td>
                <td>{{ column_name }}</td>
                <td>{{ column_quantity }}</td>
                <td>{{ column_price }}</td>
                <td>{{ column_total }}</td>
                <td></td>
              </thead>
              <tbody>

              {% for product in products %}
                <tr>
                  <td data-title="{{ column_image }}"><img src="{{ product.thumb }}" alt="{{ product.name }}"></td>
                  <td data-title="{{ column_name }}">{{ product.name }}
                      {% for option in product.option %} <br />
                        &nbsp;<small> - {{ option.name }}: {{ option.value }}</small> {% endfor %}</td>
                  <td data-title="{{ column_quantity }}">{{ product.quantity }}</td>
                  <td data-title="{{ column_price }}">{{ product.price }}</td>
                  <td data-title="{{ column_total }}">{{ product.total }}</td>
                  <td data-title="{{ text_action }}" class="uk-text-right" style="white-space: nowrap;">{% if product.reorder %} <a href="{{ product.reorder }}" data-toggle="tooltip" title="{{ button_reorder }}" class="btn btn-primary"><i class="fa fa-shopping-cart"></i></a> {% endif %} <a href="{{ product.return }}" data-toggle="tooltip" title="{{ button_return }}" class="btn btn-danger"><i class="fa fa-reply"></i></a></td>

                </tr>
              {% endfor %}
              {% for voucher in vouchers %}
                <tr>
                  <td class="text-left">{{ voucher.description }}</td>
                  <td class="text-left"></td>
                  <td class="text-right">1</td>
                  <td class="text-right">{{ voucher.amount }}</td>
                  <td class="text-right">{{ voucher.amount }}</td>
                    {% if products %}
                      <td></td>
                    {% endif %} </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        </div>


        <div class="uk-grid">
          <div class="uk-width-medium-6-10"></div>
          <div class="uk-width-medium-4-10">
            <table class="table table-bordered">
                {% for total in totals %}
                  <tr>
                    <td><strong>{{ total.title }}</strong></td>
                    <td class="uk-text-right">{{ total.text }}</td>
                  </tr>
                {% endfor %}
            </table>
          </div>
        </div>

      </div>
      <div class="uk-width-medium-1-3">

        <div class="block-panel">
          <h3>{{ text_order_detail }}</h3>
          <div class="content">
              {% if invoice_no %}
                  <p><strong>{{ text_invoice_no }}</strong> {{ invoice_no }}</p>
              {% endif %}

            <p><strong>{{ text_order_id }} : </strong> {{ order_id }}</p>
            <p><strong>{{ text_date_added }} : </strong> {{ date_added }}</p>
              {% if payment_method %}
               <p><strong>{{ text_payment_method }} : </strong> {{ payment_method }}</p>
              {% endif %}
              {% if shipping_method %}
                <p><strong>{{ text_shipping_method }} : </strong> {{ shipping_method }} </p>
              {% endif %}
            <p></p>
          </div>
        </div>


        <div class="block-panel">
          <h3>{{ text_payment_address }}</h3>
          <div class="content">
            {{ payment_address }}
          </div>
        </div>

          {% if shipping_address %}
            <div class="block-panel">
              <h3>{{ text_shipping_address }}</h3>
              <div class="content">
                {{ shipping_address }}
              </div>
            </div>
          {% endif %}

          {% if comment %}
            <div class="block-panel">
              <h3>{{ text_comment }}</h3>
              <div class="content">
                  {{ comment }}
              </div>
            </div>
          {% endif %}

      </div>
    </div>

    <div class="buttons uk-margin-top clearfix">
      <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
    </div>
  </div>
</div>

{{ footer }}