{{ header }}
<div id="account-wishlist" class="uk-container uk-container-center uk-margin-large-top">

  <div class="uk-panel uk-panel-box uk-panel-box-secondary">
    <ul class="uk-breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>
    <h1 class="uk-panel-title">{{ heading_title }}</h1>
      {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}

      {% if products %}
        <div class="custom-table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
            <tr>
              <td>{{ column_image }}</td>
              <td>{{ column_name }}</td>
              <td>{{ column_stock }}</td>
              <td>{{ column_price }}</td>
              <td>{{ column_action }}</td>
            </tr>
            </thead>
            <tbody>

            {% for product in products %}
              <tr>
                <td data-title="{{ column_image }}">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a>{% endif %}</td>
                <td data-title="{{ column_name }}"><a href="{{ product.href }}">{{ product.name }}</a></td>
                <td data-title="{{ column_stock }}">{{ product.stock }}</td>
                <td data-title="{{ column_price }}">{% if product.price %}
                    <div class="price"> {% if not product.special %}
                            {{ product.price }}
                        {% else %} <b>{{ product.special }}</b> <s>{{ product.price }}</s> {% endif %} </div>
                    {% endif %}</td>
                <td data-title="{{ column_action }}" class="uk-text-right"><button type="button" onclick="cart.add('{{ product.product_id }}');" data-toggle="tooltip" title="{{ button_cart }}" class="btn btn-primary"><i class="fa fa-shopping-cart"></i></button>
                  <a href="{{ product.remove }}" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-times"></i></a></td>
              </tr>
            {% endfor %}
            </tbody>

          </table>
        </div>
      {% else %}
        <div class="empty">
          <p>{{ text_empty }}</p>
        </div>
      {% endif %}
    <div class="buttons clearfix">
      <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
    </div>
  </div>

</div>
{{ footer }}