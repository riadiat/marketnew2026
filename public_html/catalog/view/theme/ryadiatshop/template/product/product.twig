    new Swiper('#banners-re', {
        slidesPerView: 3,
        simulateTouch:false,
        loop: false,
        autoplay: 2500,
        autoplayDisableOnInteraction: false,
        spaceBetween: 10,
        breakpoints: {
            1075: {
                slidesPerView: 3,
                loop: true
            },
            768: {
                slidesPerView: 3,
                loop: true
            },
            640: {
                slidesPerView: 2,
                loop: true
            },
