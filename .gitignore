# --- Secrets / per-environment ------------------------------------------
# The three config.php files are committed: they contain no credentials any
# more, only __DIR__-derived paths and oc_env() lookups. Real values come from
# the vhost, the environment, or this file — which never gets committed.
public_html/env.local.php
.env

# --- Runtime data --------------------------------------------------------
storage/cache/*
storage/cache-seller/*
storage/logs/*
storage/logs-seller/*
storage/session/*
storage/session-seller/*
storage/modification/*
storage/modification-seller/*
storage/download/*
storage/download-seller/*
storage/upload/*
storage/xls/*
public_html/system/storage/cache/*
public_html/system/storage/cache-seller/*
public_html/system/storage/logs/*
public_html/system/storage/logs-seller/*
public_html/system/storage/session/*
public_html/system/storage/session-seller/*
public_html/system/storage/modification/*
public_html/system/storage/modification-seller/*
public_html/system/storage/upload/*
!**/index.html
!**/.htaccess

# Generated thumbnails (regenerated on demand)
public_html/image/cache/

# NOTE: storage/vendor/ and public_html/system/storage/vendor/ are deliberately
# committed. composer.json pins 2017-era packages that no longer resolve on PHP
# 8.3, and the bundled copies carry local PHP 8 fixes.
# Do not run `composer install` against this project.

# --- Large / non-source assets ------------------------------------------
# 153 MB SQL dump + 720 MB of uploaded product images: keep these in object
# storage or a backup bucket, not in git.
database/*.sql
database/*.sql.gz
public_html/image/catalog/

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Forensic copies of obfuscated files (see docs/SECURITY.md) ----------
.quarantine/
/docs/*
/.docker/*
docker-compose.yml
README.md